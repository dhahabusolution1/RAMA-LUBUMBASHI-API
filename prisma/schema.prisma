// ============================================================
// schema.prisma — La Parole Eternelle v2
// PostgreSQL 18 · Prisma 7.8.0
// ============================================================

generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  // Optimisation Prisma 7.3.0+ : fast pour la vitesse de build, small pour la taille du bundle
  compilerBuild = "fast"
  engineType    = "client"
}

datasource db {
  provider  = "postgresql"
}

// ─── ENUMS ───────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  FIDELE
}

enum TypeEvenement {
  EVENEMENT
  PROGRAMME_CULTE
}

enum StatutEvenement {
  BROUILLON
  PUBLIE
  ANNULE
  TERMINE
}

enum TypeEmission {
  EMISSION_TV
  EMISSION_RADIO
}

enum TypeCulte {
  MERCREDI
  VENDREDI
  SAMEDI
  DIMANCHE
  SEMINAIRE
  CONCERT
  AUTRE
}

enum StatutCulte {
  PLANIFIE
  EN_DIRECT
  REDIFFUSION
}

// 6 types de demandes fideles fusionnees en une seule table (BAPTEME est conservé pour l'historique)
enum TypeRequete {
  PRIERE
  PRIERE_SALUT
  RENOUVELLEMENT
  INTEGRATION
  DEMANDE_INFO
  BAPTEME
}

// Statuts unifies — la couche service enforce les statuts valides par type
enum StatutRequete {
  EN_ATTENTE
  LU
  REPONDU
  EN_PRIERE
  TERMINE
  CONTACTE
  INTEGRE
  ABANDONNE
  CONFIRME
  REALISE
  ANNULE
}

enum TypeDemandePriere {
  MOI
  AUTRE
}

enum StatutRendezVous {
  EN_ATTENTE
  CONFIRME
  EFFECTUE
  ANNULE
}

enum StatutMessage {
  ENVOYE
  LU
}

enum StatutConversation {
  OUVERTE
  FERMEE
}

enum Plateforme {
  IOS
  ANDROID
}

// ─── BOOKSHOP ENUMS ──────────────────────────────────────────

enum CategorieArticle {
  EGLISE
  PARTENAIRE
}

enum TypeArticle {
  LIVRE
  VETEMENT
  ACCESSOIRE
  AUTRE
}

enum Devise {
  USD
  CDF
}

enum StatutDon {
  EN_ATTENTE
  EN_COURS
  REUSSI
  ECHEC
  ANNULE
}

// ─── SESSIONS FORMULAIRES ────────────────────────────────────

enum TypeSession {
  BAPTEME
  ENREGISTREMENT_MEMBRE
}

enum StatutInscription {
  EN_ATTENTE
  VALIDE
  REFUSE
}

enum Sexe {
  MASCULIN
  FEMININ
}

enum EtatCivil {
  CELIBATAIRE
  MARIE
  DIVORCE
  VEUF
}

// ─── UTILISATEURS ────────────────────────────────────────────

model User {
  id             String    @id @default(uuid())
  nom            String
  postnom        String?
  prenom         String?
  /// Identifiant de connexion pour les comptes ADMIN et SUPER_ADMIN
  email          String?   @unique
  /// Identifiant de connexion pour les comptes FIDELE
  numeroWhatsapp String?   @unique
  motDePasseHash String?
  photoUrl       String?
  role           Role      @default(FIDELE)
  /// Soft delete : l'utilisateur reste en base pour preserver l'integrite des relations
  deletedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  fcmTokens            FcmToken[]
  conversationFidele   Conversation?  @relation("FideleConversation")
  conversationsAdmin   Conversation[] @relation("AdminConversation")
  messages             Message[]
  auditLogs            AuditLog[]
  requetes             Requete[]
  rendezVous           RendezVous[]
  inscriptionsSession  InscriptionSession[]
  eglisesComme         Eglise[]
  dons                 DonTransaction[]
  notifications        Notification[]

  @@index([role])
  @@index([deletedAt])
}

model FcmToken {
  id         String     @id @default(uuid())
  token      String     @unique
  plateforme Plateforme
  /// Optionnel : les visiteurs anonymes peuvent recevoir des notifications generales
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─── CONTENU BIBLIQUE ────────────────────────────────────────

model VersetJour {
  id              String   @id @default(uuid())
  reference       String
  texte           String
  meditation      String?
  versionBiblique String   @default("LSG")
  datePublication DateTime
  estActif        Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estActif])
  @@index([datePublication])
}

// ─── EVENEMENTS & PROGRAMMES CULTE (table fusionnee) ─────────

model Evenement {
  id              String          @id @default(uuid())
  type            TypeEvenement   @default(EVENEMENT)
  titre           String
  description     String?
  dateDebut       DateTime        @default(now())
  dateFin         DateTime?
  heure           String?
  lieu            String?
  imageUrl        String?
  imageExterneUrl String?
  /// Null pour les programmes de culte
  organisateur    String?
  lienYoutube     String?
  statut          StatutEvenement @default(BROUILLON)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, statut])
  @@index([dateDebut])
}

// ─── SERMONS & PLAYLISTS ─────────────────────────────────────

model PlaylistSermon {
  id          String   @id @default(uuid())
  titre       String
  description String?
  theme       String?
  imageUrl    String?
  ordre       Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sermons Sermon[]
}

model Sermon {
  id              String          @id @default(uuid())
  titre           String
  description     String?
  predicateur     String?
  date            DateTime
  lienYoutube     String
  miniatureUrl    String?
  playlistId      String?
  playlist        PlaylistSermon? @relation(fields: [playlistId], references: [id], onDelete: SetNull)
  ordreInPlaylist Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([playlistId])
  @@index([createdAt])
}

// ─── EMISSIONS ───────────────────────────────────────────────

model Emission {
  id           String       @id @default(uuid())
  titre        String
  description  String?
  date               DateTime
  lienYoutube        String?
  mediaUrl           String?
  cloudinaryPublicId String?
  miniatureUrl       String?
  type               TypeEmission

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([date])
}

// ─── SHORT VIDEOS ─────────────────────────────────────────────

model ShortVideo {
  id                 String   @id @default(uuid())
  titre              String
  description        String?
  videoUrl           String
  miniatureUrl       String?
  cloudinaryPublicId String
  datePublication    DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([datePublication])
}

// ─── CULTES ───────────────────────────────────────────────────

model Culte {
  id           String      @id @default(uuid())
  titre        String
  description  String?
  type         TypeCulte
  date         DateTime
  lienYoutube  String?
  miniatureUrl String?
  statut       StatutCulte @default(PLANIFIE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  @@index([date])
}

// ─── CITATIONS ────────────────────────────────────────────────

model Citation {
  id                 String  @id @default(uuid())
  imageUrl           String
  cloudinaryPublicId String
  texte              String?
  auteur             String?
  description        String?

  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─── STRUCTURE ECCLESIALE ────────────────────────────────────

model Eglise {
  id              String  @id @default(uuid())
  nom             String  @unique
  photoUrl        String?
  adresse         String?
  telephone       String?
  ville           String?
  lienFacebook    String?
  pasteurNom      String?
  pasteurPhotoUrl String?
  /// Lien optionnel vers un compte utilisateur admin
  pasteurUserId   String?
  pasteur         User?   @relation(fields: [pasteurUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requetes Requete[]
  cellules Cellule[]
  inscriptions InscriptionSession[]
}

model Cellule {
  id                 String  @id @default(uuid())
  nom                String
  quartiersCouvertes String?
  adresseReunion     String?
  reference          String?
  telephone1         String?
  telephone2         String?
  egliseId           String?
  eglise             Eglise? @relation(fields: [egliseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([egliseId])
}

model Departement {
  id          String  @id @default(uuid())
  nom         String
  responsable String?
  mission     String?
  historique  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inscriptionsDepartement InscriptionDepartement[]
}

// ─── REQUETES FIDELES (table unifiee, 6 types) ───────────────
//
// Auth requise pour PRIERE et BAPTEME → userId non nul.
// Soumission publique pour PRIERE_SALUT, RENOUVELLEMENT, INTEGRATION,
// DEMANDE_INFO → userId nullable, champs de contact obligatoires.
//
model Requete {
  id   String      @id @default(dbgenerated("uuidv7()"))
  type TypeRequete

  // Auteur authentifie (PRIERE, BAPTEME)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Auteur visiteur public (PRIERE_SALUT, RENOUVELLEMENT, INTEGRATION, DEMANDE_INFO)
  nomVisiteur      String?
  prenomVisiteur   String?
  whatsappVisiteur String?
  emailVisiteur    String?

  // Reference eglise (PRIERE_SALUT, INTEGRATION, BAPTEME) — liste prédéfinie
  egliseId String?
  eglise   Eglise? @relation(fields: [egliseId], references: [id], onDelete: SetNull)
  /// Nom d'église saisi librement (RENOUVELLEMENT d'engagement)
  egliseNom String?

  // Message generique (PRIERE, DEMANDE_INFO)
  message String?
  reponseAdmin String?

  // Specifique PRIERE uniquement
  typePriere TypeDemandePriere?
  estMembre  Boolean?

  statut      StatutRequete @default(EN_ATTENTE)
  dateDemande DateTime      @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([userId])
  @@index([statut])
  @@index([egliseId])
  @@index([createdAt])
}

// ─── RENDEZ-VOUS ──────────────────────────────────────────────
//
// Auth requise → userId FK obligatoire.
// L'index unique partiel (hors statut ANNULE) est declare nativement
// grace au support des index partiels de Prisma 7.4+.
//
model RendezVous {
  id     String           @id @default(uuid())
  // Optionnel : lien vers un utilisateur authentifie
  userId String?
  user   User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Informations de contact pour les visiteurs non authentifies
  nomVisiteur      String?
  prenomVisiteur   String?
  whatsappVisiteur String?

  date   DateTime         @db.Date
  heure  String
  motif  String
  statut StatutRendezVous @default(EN_ATTENTE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([userId])
  @@index([statut])
  // Unicité partielle (hors ANNULE) : voir migration RendezVous_unique_slot
}

// ─── MESSAGERIE ──────────────────────────────────────────────

model Conversation {
  id      String             @id @default(uuid())
  /// Un fidele ne peut avoir qu'une seule conversation active
  fideleId String            @unique
  fidele  User               @relation("FideleConversation", fields: [fideleId], references: [id], onDelete: Cascade)
  /// Admin ayant pris en charge la conversation
  adminId String?
  admin   User?              @relation("AdminConversation", fields: [adminId], references: [id], onDelete: SetNull)
  statut  StatutConversation @default(OUVERTE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([statut])
  @@index([adminId])
}

model Message {
  id             String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  expediteurId   String
  expediteur     User          @relation(fields: [expediteurId], references: [id], onDelete: Cascade)
  contenu        String
  statut         StatutMessage @default(ENVOYE)

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([statut])
}

// ─── BOOKSHOP ────────────────────────────────────────────────

model ArticleBookshop {
  id                  String           @id @default(uuid())
  titre               String
  auteur              String?
  prix                Decimal          @db.Decimal(10, 2)
  devise              Devise           @default(USD)
  description         String?
  couvertureUrl       String?
  cloudinaryPublicId  String?
  /// Si null, utilise le numero WhatsApp global de ConfigurationApp
  numeroWhatsappAchat String?
  estDisponible       Boolean          @default(true)

  stock               Int              @default(0)
  ventes              Int              @default(0)
  categorie           CategorieArticle @default(EGLISE)
  typeArticle         TypeArticle      @default(LIVRE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estDisponible])
  @@index([categorie, typeArticle])
}

// ─── CONFIGURATION APP (singleton) ───────────────────────────

model ConfigurationApp {
  /// ID fixe garantissant l'unicite du singleton
  id                    String  @id @default("GLOBAL_CONFIG")
  programmeHebdomadaire String?
  /// Déroulement du culte dominical (ordre du service du dimanche)
  programmeDimanche     String?
  numeroWhatsappContact String?
  numeroWhatsappBookshop String?
  lienGroupeWhatsapp    String?

  updatedAt DateTime @updatedAt

  imagesAccueil   ImageAccueil[]
  coordonneesDons CoordonneesDon[]
}

model ImageAccueil {
  id                 String           @id @default(uuid())
  configId           String
  config             ConfigurationApp @relation(fields: [configId], references: [id], onDelete: Cascade)
  imageUrl           String
  cloudinaryPublicId String
  ordre              Int              @default(0)
  estActif           Boolean          @default(true)

  @@index([configId, ordre])
}

model CoordonneesDon {
  id       String           @id @default(uuid())
  configId String
  config   ConfigurationApp @relation(fields: [configId], references: [id], onDelete: Cascade)
  libelle  String
  valeur   String
  detail   String?
  ordre    Int              @default(0)

  @@index([configId, ordre])
}

// ─── AUDIT LOG ───────────────────────────────────────────────

model AuditLog {
  id       String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  acteurId String
  acteur   User    @relation(fields: [acteurId], references: [id], onDelete: Cascade)
  action   String
  entite   String
  entiteId String?
  details  Json?

  createdAt DateTime @default(now())

  @@index([acteurId])
  @@index([entite, entiteId])
  @@index([createdAt])
}

// ─── SESSIONS ET INSCRIPTIONS ────────────────────────────────

model SessionFormulaire {
  id          String       @id @default(uuid())
  titre       String
  description String?
  type        TypeSession
  dateDebut   DateTime
  dateFin     DateTime
  estActif    Boolean      @default(true)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  inscriptions InscriptionSession[]

  @@index([type])
  @@index([dateDebut, dateFin])
}

model InscriptionSession {
  id                  String            @id @default(uuid())
  sessionFormulaireId String
  sessionFormulaire   SessionFormulaire @relation(fields: [sessionFormulaireId], references: [id], onDelete: Cascade)
  
  userId              String?
  user                User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  nom                 String
  postnom             String?
  prenom              String
  telephone           String
  adresse             String?

  egliseId            String?
  eglise              Eglise?           @relation(fields: [egliseId], references: [id], onDelete: SetNull)
  /// Antenne / église d'appartenance saisie librement (identification membre)
  egliseNom           String?

  // ── Identification membre (ENREGISTREMENT_MEMBRE) ──
  matricule          String?   @unique
  matriculeExpireAt  DateTime?
  numeroCarteMembre  String?   @unique
  telephone2         String?
  email              String?
  sexe               Sexe?
  dateNaissance      DateTime? @db.Date
  lieuNaissance      String?
  etatCivil          EtatCivil?
  dateBapteme        DateTime? @db.Date
  lieuBapteme        String?
  dateAdhesion       DateTime? @db.Date
  niveauEtudes       String?
  profession         String?
  adressePhysique    String?
  ville              String?
  commune            String?
  quartier           String?
  formationEglise    String?
  autresSavoirFaire  String?
  nomConjoint        String?
  nombreEnfants      Int?
  /// Photo jointe à l'identification membre
  captureFicheUrl       String?
  captureFichePublicId  String?

  statut              StatutInscription @default(EN_ATTENTE)

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  departements InscriptionDepartement[]

  @@index([sessionFormulaireId])
  @@index([statut])
  @@index([matricule])
}

model InscriptionDepartement {
  id                   String             @id @default(uuid())
  inscriptionSessionId String
  inscriptionSession   InscriptionSession @relation(fields: [inscriptionSessionId], references: [id], onDelete: Cascade)
  departementId        String?
  departement          Departement?       @relation(fields: [departementId], references: [id], onDelete: SetNull)
  fonction             String?
  depuis               DateTime?          @db.Date
  ordre                Int                @default(1)

  @@index([inscriptionSessionId])
}

/// Transaction de don via MaxiCash (PayEntryWeb — redirection navigateur)
model DonTransaction {
  id                    String     @id @default(uuid())
  userId                String?
  user                  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  montant               Decimal    @db.Decimal(12, 2)
  devise                Devise     @default(CDF)
  /// Montant envoyé à MaxiCash (centimes USD ou unités FC)
  montantMaxicash       Int
  currencyMaxicash      String
  reference             String     @unique
  logId                 String?
  maxicashTransactionId String?
  statut                StatutDon  @default(EN_ATTENTE)
  message               String?
  telephonePayeur       String?
  metadata              Json?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([userId])
  @@index([statut])
  @@index([logId])
}

// ─── NOTIFICATIONS PERSISTEES ────────────────────────────────

model Notification {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  telephoneDest String?

  titre     String
  corps     String
  lu        Boolean  @default(false)
  type      String?
  metaId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}
