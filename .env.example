# ============================================================
# SERVEUR
# ============================================================
NODE_ENV=development
PORT=4000

# ============================================================
# BASE DE DONNÉES (PostgreSQL 18 via Supabase)
# ============================================================
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?pgbouncer=true&connection_limit=1"
# URL directe pour les migrations (sans PgBouncer)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ============================================================
# CACHE & PUB/SUB (Redis 8.6)
# ============================================================
REDIS_URL="redis://localhost:6379"

# ============================================================
# AUTHENTIFICATION JWT
# ============================================================
JWT_SECRET="remplacer-par-une-valeur-aleatoire-de-64-caracteres"
JWT_REFRESH_SECRET="remplacer-par-une-autre-valeur-aleatoire-de-64-caracteres"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="30d"

# ============================================================
# CLOUDINARY (Stockage CDN)
# ============================================================
CLOUDINARY_CLOUD_NAME="votre-cloud-name"
CLOUDINARY_API_KEY="votre-api-key"
CLOUDINARY_API_SECRET="votre-api-secret"

# ============================================================
# FIREBASE (Cloud Messaging — Notifications Push)
# ============================================================
# Chemin vers le fichier JSON du compte de service Firebase Admin
GOOGLE_APPLICATION_CREDENTIALS="./firebase-service-account.json"

# ============================================================
# YOUTUBE DATA API (Import de playlists)
# ============================================================
YOUTUBE_API_KEY="votre-cle-api-youtube-data-v3"

# ============================================================
# CORS
# ============================================================
# URLs autorisées, séparées par des virgules
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,https://admin.archesourcevie.cd"

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================
# MAXICASH (Dons — PayEntryWeb + redirection navigateur)
# ============================================================
# Identifiants marchand fournis par MaxiCash
MAXICASH_MERCHANT_ID=""
MAXICASH_MERCHANT_PASSWORD=""
# true = sandbox (webapi-test / api-testbed), false = production
MAXICASH_SANDBOX=true
# URL publique de l'API (webhooks NotifyURL et pages de retour)
APP_PUBLIC_URL="http://localhost:4000"
# Taux CDF → USD pour conversion vers maxiDollar (centimes)
MAXICASH_CDF_TO_USD_RATE=2800
# Deep link mobile après paiement (optionnel)
DON_APP_DEEP_LINK_BASE="archesourcevie://don"

# ============================================================
# IDENTITÉ ÉGLISE
# ============================================================
MATRICULE_PREFIX="ASV"
