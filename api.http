  }
}


### ============================================================
### ░░░  SECTION 12 — DEMANDES SPIRITUELLES / REQUÊTES (MODULES 12-18)  ░░░
### ============================================================
###
### Architecture unifiée : tous les types de demandes utilisent la table Requete.
###
### TYPES ACCESSIBLES À TOUS (Public ou Authentifié) :
###   - PRIERE  : demande de prière pour soi ou autrui
###   - BAPTEME : inscription au baptême
###   - PRIERE_SALUT  : prière de salut
###   - RENOUVELLEMENT: renouvellement d'engagement
###   - INTEGRATION   : demande d'intégration à l'église
###   - DEMANDE_INFO  : question ou demande d'information
###
### Statuts valides selon le type :
###   PRIERE       → EN_ATTENTE, EN_PRIERE, TERMINE, ANNULE
###   PRIERE_SALUT → EN_ATTENTE, CONTACTE, TERMINE
###   RENOUVELLEMENT→ EN_ATTENTE, CONTACTE, TERMINE
###   INTEGRATION  → EN_ATTENTE, CONTACTE, INTEGRE, ABANDONNE
###   DEMANDE_INFO → EN_ATTENTE, LU, REPONDU
###   BAPTEME      → EN_ATTENTE, CONFIRME, REALISE, ANNULE

### [AUTH - FIDELE] Soumettre une demande de prière (pour soi)
POST {{baseUrl}}
Content-Type: {{contentType}}
Authorization: Bearer {{accessTokenFidele}}

{
  "query": "mutation SoumettreRequete($input: RequeteAuthInput!) { soumettreRequete(input: $input) { id type statut typePriere estMembre dateDemande } }",
  "variables": {
    "input": {
      "type": "PRIERE",
      "message": "Je demande la prière pour ma santé et celle de ma famille.",
      "typePriere": "MOI",
      "estMembre": true
    }
  }
}

###

### [AUTH - FIDELE] Soumettre une inscription au baptême
POST {{baseUrl}}
Content-Type: {{contentType}}
Authorization: Bearer {{accessTokenFidele}}

{
  "query": "mutation SoumettreBapteme($input: RequeteAuthInput!) { soumettreRequete(input: $input) { id type statut eglise { nom } dateDemande } }",
  "variables": {
    "input": {
      "type": "BAPTEME",
      "egliseId": "{{idEglise}}"
    }
  }
}

###

### [PUBLIC] Soumettre une demande de prière (sans compte)
POST {{baseUrl}}
Content-Type: {{contentType}}

{
  "query": "mutation SoumettreRequetePublique($input: RequetePubliqueInput!) { soumettreRequetePublique(input: $input) { id type statut dateDemande } }",
  "variables": {
    "input": {
      "type": "PRIERE",
      "nomVisiteur": "Luvumbu",
      "prenomVisiteur": "David",
      "whatsappVisiteur": "+243810009988",
      "message": "Prière pour mon nouveau travail.",
      "typePriere": "MOI",
      "estMembre": false
    }
  }
}

###

### [PUBLIC] Soumettre une prière du salut (sans compte)
### Déduplication : même numéro WhatsApp → une seule soumission par jour.
POST {{baseUrl}}
Content-Type: {{contentType}}

{
  "query": "mutation SoumettrePriereSalut($input: RequetePubliqueInput!) { soumettreRequetePublique(input: $input) { id type statut dateDemande } }",
  "variables": {
    "input": {
      "type": "PRIERE_SALUT",
      "nomVisiteur": "Mbuyi",
      "prenomVisiteur": "Cynthia",
      "whatsappVisiteur": "+243899000111",
      "egliseId": "{{idEglise}}"
    }
  }
}

###

### [PUBLIC] Soumettre une demande d'intégration (sans compte)
POST {{baseUrl}}
Content-Type: {{contentType}}

{
  "query": "mutation SoumettreIntegration($input: RequetePubliqueInput!) { soumettreRequetePublique(input: $input) { id type statut dateDemande } }",
  "variables": {
    "input": {
      "type": "INTEGRATION",
      "nomVisiteur": "Banza",
      "prenomVisiteur": "Samuel",
      "whatsappVisiteur": "+243812111222",
      "emailVisiteur": "samuel.banza@email.com",
