### [ADMIN] Créer une émission
POST {{baseUrl}}
Content-Type: {{contentType}}
Authorization: Bearer {{accessTokenAdmin}}

{
  "query": "mutation CreerEmission($titre: String!, $date: DateTime!, $lien: String!, $type: TypeEmission!, $description: String) { creerEmission(titre: $titre, description: $description, date: $date, lienYoutube: $lien, type: $type) { id titre type date lienYoutube miniatureUrl } }",
  "variables": {
    "titre": "PERTV — Émission du Dimanche 3 Mai 2026",
