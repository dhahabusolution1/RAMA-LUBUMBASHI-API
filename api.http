    }
  }
}

###

### [PUBLIC] Soumettre un renouvellement d'engagement (sans compte)
POST {{baseUrl}}
Content-Type: {{contentType}}

{
  "query": "mutation SoumettreRenouvellement($input: RequetePubliqueInput!) { soumettreRequetePublique(input: $input) { id type statut dateDemande } }",
  "variables": {
    "input": {
      "type": "RENOUVELLEMENT",
      "nomVisiteur": "Kabila",
      "prenomVisiteur": "Grace",
      "whatsappVisiteur": "+243811333444",
      "egliseId": "{{idEglise}}"
    }
  }
}

###

### [PUBLIC] Soumettre une demande d'information (sans compte)
POST {{baseUrl}}
Content-Type: {{contentType}}

{
  "query": "mutation SoumettreDemandeInfo($input: RequetePubliqueInput!) { soumettreRequetePublique(input: $input) { id type statut dateDemande } }",
  "variables": {
    "input": {
      "type": "DEMANDE_INFO",
      "nomVisiteur": "Kasongo",
      "prenomVisiteur": "Ruth",
      "whatsappVisiteur": "+243897555666",
