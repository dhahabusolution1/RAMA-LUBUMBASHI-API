Content-Type: {{contentType}}
Authorization: Bearer {{accessTokenSuperAdmin}}

{
  "query": "mutation ModifierConfigDons($whatsapp: String, $coords: [CoordonneesDonInput!]) { modifierConfigurationDons(numeroWhatsappContact: $whatsapp, coordonnees: $coords) { numeroWhatsappContact coordonnees { libelle valeur detail } } }",
