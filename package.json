{
  "name": "rama-lubumbashi-backend",
  "version": "2.0.0",
  "description": "Backend API — Rama Lubumbashi (GraphQL + REST)",
  "author": "Rama Lubumbashi",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc && copyfiles -u 1 \"src/**/*.graphql\" dist/",
    "start": "npx prisma migrate deploy && node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@apollo/server": "^5.5.0",
    "@as-integrations/express5": "^1.1.2",
    "@graphql-tools/merge": "^9.0.0",
    "@graphql-tools/schema": "^10.0.0",
    "@graphql-tools/utils": "^10.0.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dataloader": "^2.2.3",
    "dotenv": "^16.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^13.8.0",
    "graphql": "^16.11.0",
    "graphql-scalars": "^1.24.0",
    "graphql-tag": "^2.12.6",
    "graphql-ws": "^6.0.8",
    "helmet": "^8.1.0",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pg": "^8.20.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "ws": "^8.18.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.5.13",
    "copyfiles": "^2.4.1",
    "jest": "^30.0.0",
    "prisma": "^7.8.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.0"
  }
}
