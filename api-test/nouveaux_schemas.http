    "input": {
      "type": "PRIERE_SALUT",
      "message": "Je souhaite donner ma vie à Jésus-Christ",
      "egliseNom": "Église Locale Salem"
    }
  }
}

### 📱 [FIDELE] Soumettre une demande d'intégration (avec église saisie librement ou ID)
POST {{graphql_url}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation SoumettreRequete($input: RequeteInput!) { soumettreRequete(input: $input) { id type egliseNom lienGroupeIntegration statut } }",
  "variables": {
    "input": {
      "type": "INTEGRATION",
      "message": "Je désire rejoindre l'église et participer activement",
      "egliseNom": "Église Locale la Grâce",
      "estMembre": false
    }
  }
}
    }
  }
}

### 📱 [FIDELE] Soumettre une demande d'information
POST {{graphql_url}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation SoumettreRequete($input: RequeteInput!) { soumettreRequete(input: $input) { id type statut } }",
  "variables": {
    "input": {
      "type": "DEMANDE_INFO",
      "message": "À quelles heures ont lieu les cultes du dimanche ?"
    }
  }
}

### 📱 [FIDELE] Soumettre un renouvellement d'engagement (église en texte libre)
POST {{graphql_url}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation SoumettreRequete($input: RequeteInput!) { soumettreRequete(input: $input) { id type egliseNom statut } }",
  "variables": {
    "input": {
      "type": "RENOUVELLEMENT",
      "egliseNom": "Église Évangélique La Grâce — Lubumbashi"
    }
  }
}

### 📱 [FIDELE] Voir mes propres requêtes
POST {{graphql_url}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "query MesRequetes { mesRequetes { id type statut message reponseAdmin dateDemande } }"
}

### 🔒 [ADMIN] Lister toutes les requêtes (paginées, filtrables)
POST {{graphql_url}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "query GetRequetes($type: TypeRequete, $statut: StatutRequete, $limit: Int, $offset: Int) { getRequetes(type: $type, statut: $statut, limit: $limit, offset: $offset) { items { id type statut message nomVisiteur whatsappVisiteur user { nom numeroWhatsapp } dateDemande } pagination { total hasNextPage } } }",
  "variables": {
    "statut": "EN_ATTENTE",
    "limit": 20,
    "offset": 0
  }
}

### 🔒 [ADMIN] Répondre à une demande d'information
POST {{graphql_url}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation RepondreRequete($id: ID!, $reponse: String!) { repondreRequete(id: $id, reponse: $reponse) { id statut reponseAdmin } }",
  "variables": {
    "id": "ID_REQUETE_ICI",
    "reponse": "Bonjour, les cultes ont lieu chaque dimanche à 9h. Nous vous attendons avec joie !"
  }
}

### 🔒 [ADMIN] Changer le statut d'une requête
POST {{graphql_url}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation UpdateStatutRequete($id: ID!, $statut: StatutRequete!) { updateStatutRequete(id: $id, statut: $statut) { id statut } }",
  "variables": {
    "id": "ID_REQUETE_ICI",
    "statut": "EN_PRIERE"
  }
}


# ═══════════════════════════════════════════════════════════════
# 3. RENDEZ-VOUS PASTORAUX (Auth obligatoire — coordonnées auto-remplies)
# ═══════════════════════════════════════════════════════════════
# ⚠ IMPORTANT : Ces mutations nécessitent OBLIGATOIREMENT un token.
# Ne pas envoyer nomVisiteur / whatsappVisiteur : le backend les renseigne
# automatiquement depuis le profil de l'utilisateur connecté.

### 🌐 [PUBLIC] Vérifier la disponibilité d'un jour
POST {{graphql_url}}
Content-Type: application/json

{
  "query": "query GetDisponibilite($date: Date!) { getDisponibiliteJour(date: $date) { date slotsRestants estComplet heuresDisponibles heuresPrises creneaux { heure disponible } } }",
  "variables": {
    "date": "2026-07-15"
  }
}

### 🌐 [PUBLIC] Disponibilités sur une période (calendrier)
POST {{graphql_url}}
Content-Type: application/json

{
  "query": "query GetDispoPeriode($dateDebut: Date!, $dateFin: Date!) { getDisponibilitesPeriode(dateDebut: $dateDebut, dateFin: $dateFin) { date estComplet heuresDisponibles creneaux { heure disponible } } }",
  "variables": {
    "dateDebut": "2026-07-01",
    "dateFin": "2026-07-31"
  }
}

### 🌐 [PUBLIC] Trouver le prochain jour disponible
POST {{graphql_url}}
Content-Type: application/json

{
  "query": "query GetProchainJour { getProchainJourDisponible }"
}

### 📱 [FIDELE] Prendre un rendez-vous pastoral
POST {{graphql_url}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation PrendreRendezVous($date: Date!, $heure: String!, $motif: String) { prendreRendezVous(date: $date, heure: $heure, motif: $motif) { id date heure motif statut } }",
  "variables": {
    "date": "2026-07-15",
    "heure": "10:00",
    "motif": "Besoin de conseils pour préparer mon mariage"
  }
}

### 📱 [FIDELE] Voir mes propres rendez-vous
POST {{graphql_url}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "query MesRendezVous { mesRendezVous { id date heure motif statut } }"
}

### 🔒 [ADMIN] Lister tous les rendez-vous (admin)
POST {{graphql_url}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "query GetRendezVous($statut: StatutRendezVous, $dateDebut: Date, $dateFin: Date, $limit: Int, $offset: Int) { getRendezVous(statut: $statut, dateDebut: $dateDebut, dateFin: $dateFin, limit: $limit, offset: $offset) { id date heure motif statut nomVisiteur whatsappVisiteur user { nom numeroWhatsapp } } }",
  "variables": {
    "statut": "EN_ATTENTE",
    "limit": 20,
    "offset": 0
  }
}

### 🔒 [ADMIN] Changer le statut d'un rendez-vous
POST {{graphql_url}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation UpdateStatutRendezVous($id: ID!, $statut: StatutRendezVous!) { updateStatutRendezVous(id: $id, statut: $statut) { id statut } }",
  "variables": {
    "id": "ID_RENDEZVOUS_ICI",
    "statut": "CONFIRME"
  }
}


# ═══════════════════════════════════════════════════════════════
# 4. BOOKSHOP (stock, ventes, devise, typeArticle, whatsappAchatUrl)
# ═══════════════════════════════════════════════════════════════

### 🔒 [ADMIN] Créer un article — Livre (Partenaire)
POST {{graphql_url}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation CreerArticle($titre: String!, $prix: Decimal!, $devise: Devise, $categorie: CategorieArticle, $typeArticle: TypeArticle, $stock: Int, $estDisponible: Boolean) { creerArticle(titre: $titre, prix: $prix, devise: $devise, categorie: $categorie, typeArticle: $typeArticle, stock: $stock, estDisponible: $estDisponible) { id titre typeArticle categorie stock ventes devise } }",
  "variables": {
    "titre": "Le Chemin de la Foi",
    "prix": 12.00,
    "devise": "USD",
    "categorie": "PARTENAIRE",
    "typeArticle": "LIVRE",
    "stock": 30,
    "estDisponible": true
  }
}

### 🔒 [ADMIN] Créer un article — Vêtement (Église)
POST {{graphql_url}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation CreerArticle($titre: String!, $prix: Decimal!, $devise: Devise, $categorie: CategorieArticle, $typeArticle: TypeArticle, $stock: Int) { creerArticle(titre: $titre, prix: $prix, devise: $devise, categorie: $categorie, typeArticle: $typeArticle, stock: $stock) { id titre stock } }",
  "variables": {
    "titre": "T-shirt Parole Éternelle",
    "prix": 15.00,
    "devise": "USD",
    "categorie": "EGLISE",
    "typeArticle": "VETEMENT",
    "stock": 50
  }
}

### 🔒 [ADMIN] Modifier un article
POST {{graphql_url}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation ModifierArticle($id: ID!, $prix: Decimal, $stock: Int, $estDisponible: Boolean) { modifierArticle(id: $id, prix: $prix, stock: $stock, estDisponible: $estDisponible) { id titre prix stock estDisponible } }",
  "variables": {
    "id": "ID_ARTICLE_ICI",
    "prix": 10.00,
    "stock": 25,
    "estDisponible": true
  }
}

### 🔒 [ADMIN] Signaler une vente (décrémente le stock automatiquement)
POST {{graphql_url}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation SignalerVente($id: ID!, $quantite: Int) { signalerVente(id: $id, quantite: $quantite) { id titre stock ventes } }",
  "variables": {
    "id": "ID_ARTICLE_ICI",
    "quantite": 2
  }
}

### 🔒 [ADMIN] Supprimer un article
POST {{graphql_url}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation SupprimerArticle($id: ID!) { supprimerArticle(id: $id) }",
  "variables": {
    "id": "ID_ARTICLE_ICI"
  }
}

### 🌐 [PUBLIC] Lister les articles disponibles (app mobile)
POST {{graphql_url}}
Content-Type: application/json

{
  "query": "query GetArticles($categorie: CategorieArticle, $typeArticle: TypeArticle, $limit: Int, $offset: Int) { getArticles(categorie: $categorie, typeArticle: $typeArticle, limit: $limit, offset: $offset) { items { id titre auteur prix devise typeArticle categorie estDisponible stock whatsappAchatUrl } totalCount } }",
  "variables": {
    "limit": 10,
    "offset": 0
  }
}

### 🌐 [PUBLIC] Obtenir la configuration des dons
POST {{graphql_url}}
Content-Type: application/json

{
  "query": "query GetConfigDons { getConfigurationDons { numeroWhatsappContact coordonnees { id libelle valeur detail } } }"
}

### 🔑 [SUPER_ADMIN] Modifier la configuration des dons
POST {{graphql_url}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation ModifierConfigDons($numero: String, $coordonnees: [CoordonneesDonInput!]) { modifierConfigurationDons(numeroWhatsappContact: $numero, coordonnees: $coordonnees) { numeroWhatsappContact coordonnees { libelle valeur } } }",
  "variables": {
    "numero": "+243999000123",
    "coordonnees": [
      { "libelle": "Mobile Money — Orange", "valeur": "+243999000123", "detail": "Au nom de La Parole Éternelle", "ordre": 0 },
      { "libelle": "Mobile Money — Airtel", "valeur": "+243888000456", "detail": "Au nom de La Parole Éternelle", "ordre": 1 }
    ]
  }
}


# ═══════════════════════════════════════════════════════════════
# 5. SESSIONS & FORMULAIRES (Baptême, Enregistrement Membres)
# ═══════════════════════════════════════════════════════════════
# ⚠ Les types sont SessionFormulaireInput et InscriptionSessionInput.
# L'inscription nécessite un token — les champs nom/prenom/telephone
# sont optionnels (remplis automatiquement depuis le profil).

### 🔒 [ADMIN] Créer une session de Baptême
POST {{graphql_url}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation CreerSession($input: SessionFormulaireInput!) { creerSession(input: $input) { id titre type dateDebut dateFin estActif } }",
  "variables": {
    "input": {
      "type": "BAPTEME",
      "titre": "Session Baptême — Juillet 2026",
      "description": "Inscriptions pour le prochain baptême",
      "dateDebut": "2026-07-01T00:00:00.000Z",
      "dateFin": "2026-07-31T23:59:59.000Z",
      "estActif": true
    }
  }
}

### 🔒 [ADMIN] Créer une session d'Enregistrement des Membres
POST {{graphql_url}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation CreerSession($input: SessionFormulaireInput!) { creerSession(input: $input) { id titre type dateDebut dateFin estActif } }",
  "variables": {
    "input": {
      "type": "ENREGISTREMENT_MEMBRE",
      "titre": "Enregistrement Membres — Août 2026",
      "description": "Inscriptions pour les cartes membres",
      "dateDebut": "2026-08-01T00:00:00.000Z",
      "dateFin": "2026-08-31T23:59:59.000Z",
      "estActif": false
    }
  }
}

### 🔒 [ADMIN] Modifier / Activer ou désactiver une session
POST {{graphql_url}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation ModifierSession($id: ID!, $input: SessionFormulaireInput!) { modifierSession(id: $id, input: $input) { id titre estActif } }",
  "variables": {
    "id": "ID_SESSION_ICI",
    "input": {
      "type": "BAPTEME",
      "titre": "Session Baptême — Juillet 2026",
      "dateDebut": "2026-07-01T00:00:00.000Z",
      "dateFin": "2026-07-31T23:59:59.000Z",
      "estActif": true
    }
  }
}

### 🔒 [ADMIN] Supprimer une session
POST {{graphql_url}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation SupprimerSession($id: ID!) { supprimerSession(id: $id) }",
  "variables": {
    "id": "ID_SESSION_ICI"
  }
}

### 🌐 [PUBLIC] Lister les sessions (filtrables par type)
POST {{graphql_url}}
Content-Type: application/json

{
  "query": "query GetSessions($type: TypeSession) { getSessions(type: $type) { id titre type dateDebut dateFin estActif } }",
  "variables": {
    "type": "BAPTEME"
  }
}

### 🌐 [PUBLIC] Vérifier si une session est active (avant d'afficher le formulaire)
POST {{graphql_url}}
Content-Type: application/json

{
  "query": "query GetSessionActive($type: TypeSession!) { getSessionActive(type: $type) { id titre type dateDebut dateFin estActif } }",
  "variables": {
    "type": "BAPTEME"
  }
}

### 📱 [FIDELE] Soumettre une inscription baptême
POST {{graphql_url}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation SoumettreInscription($input: InscriptionSessionInput!) { soumettreInscription(input: $input) { id nom prenom telephone statut createdAt } }",
  "variables": {
    "input": {
      "sessionFormulaireId": "ID_SESSION_ICI",
      "adresse": "123 Avenue de la Paix, Gombe",
      "egliseId": "ID_EGLISE_ICI"
    }
  }
}

### 📱 [FIDELE] Soumettre une fiche d'identification membre (ENREGISTREMENT_MEMBRE)
POST {{graphql_url}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation SoumettreInscriptionMembre($input: InscriptionSessionInput!) { soumettreInscription(input: $input) { id nom prenom telephone matricule statut } }",
  "variables": {
    "input": {
      "sessionFormulaireId": "ID_SESSION_MEMBRE_ICI",
      "profilMembre": {
        "telephone2": "0812345678",
        "email": "membre@example.cd",
        "sexe": "FEMININ",
        "dateNaissance": "1995-03-15",
        "lieuNaissance": "Lubumbashi",
        "etatCivil": "CELIBATAIRE",
        "dateBapteme": "2018-08-12",
        "lieuBapteme": "Campus LPE Lubumbashi",
        "niveauEtudes": "Licence",
        "profession": "Enseignante",
        "adressePhysique": "Av. Kasai 45, Q. Kenya",
        "egliseNom": "Église Évangélique La Grâce — Lubumbashi",
        "dateAdhesion": "2024-06-01",
        "captureFicheUrl": "https://res.cloudinary.com/.../inscriptions/xxx.jpg",
        "captureFichePublicId": "parole-eternelle/inscriptions/xxx",
        "formationEglise": "École de disciples — 2019",
        "autresSavoirFaire": "Chant, accueil",
        "nomConjoint": null,
        "nombreEnfants": 0,
        "departements": [
          {
            "departementId": "ID_DEPARTEMENT_ICI",
            "fonction": "Choriste",
            "depuis": "2020-01-01"
          }
        ]
      }
    }
  }
}

### 🔒 [ADMIN] Lister toutes les inscriptions d'une session
POST {{graphql_url}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "query GetInscriptions($sessionId: ID!) { getInscriptions(sessionId: $sessionId) { id nom postnom prenom telephone adresse statut user { id nom } createdAt } }",
  "variables": {
    "sessionId": "ID_SESSION_ICI"
  }
}

### 🔒 [ADMIN] Valider ou refuser une inscription
POST {{graphql_url}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation ModifierStatutInscription($id: ID!, $statut: StatutInscription!) { modifierStatutInscription(id: $id, statut: $statut) { id nom statut matricule numeroCarteMembre dateAdhesion } }",
  "variables": {
    "id": "ID_INSCRIPTION_ICI",
    "statut": "VALIDE"
  }
}


# ═══════════════════════════════════════════════════════════════
# 6. ÉMISSIONS (TV vs Radio, mediaUrl Cloudinary)
# ═══════════════════════════════════════════════════════════════

### 🔒 [ADMIN] Créer une émission TV (lien YouTube requis)
POST {{graphql_url}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation CreerEmission($titre: String!, $date: DateTime!, $type: TypeEmission!, $lienYoutube: String) { creerEmission(titre: $titre, date: $date, type: $type, lienYoutube: $lienYoutube) { id titre type lienYoutube } }",
  "variables": {
    "type": "EMISSION_TV",
    "titre": "La Parole en Direct — Spécial Noël",
    "date": "2026-12-25T10:00:00.000Z",
    "lienYoutube": "https://www.youtube.com/watch?v=XXXXXXXXX"
  }
}

### 🔒 [ADMIN] Créer une émission Radio (fichier Cloudinary)
POST {{graphql_url}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation CreerEmission($titre: String!, $date: DateTime!, $type: TypeEmission!, $mediaUrl: String, $cloudinaryPublicId: String) { creerEmission(titre: $titre, date: $date, type: $type, mediaUrl: $mediaUrl, cloudinaryPublicId: $cloudinaryPublicId) { id titre type mediaUrl } }",
  "variables": {
    "type": "EMISSION_RADIO",
    "titre": "Podcast Matinal — Prière du Réveil",
    "date": "2026-06-01T07:00:00.000Z",
    "mediaUrl": "https://res.cloudinary.com/votre-cloud/video/upload/emissions_radio/audio_001.mp3",
    "cloudinaryPublicId": "emissions_radio/audio_001"
  }
}

### 🌐 [PUBLIC] Lister les émissions (filtrable par type)
POST {{graphql_url}}
Content-Type: application/json

{
  "query": "query GetEmissions($type: TypeEmission, $limit: Int, $offset: Int) { getEmissions(type: $type, limit: $limit, offset: $offset) { items { id titre type date lienYoutube mediaUrl miniatureUrl } totalCount } }",
  "variables": {
    "type": "EMISSION_RADIO",
    "limit": 10,
    "offset": 0
  }
}


