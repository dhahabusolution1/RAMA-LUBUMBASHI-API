### 🌐 [PUBLIC] Obtenir toutes les données de la page d'accueil (app mobile)
POST {{graphql_url}}
Content-Type: application/json

{
  "query": "query GetAccueil { getAccueil { programmeHebdomadaire imagesAccueil { id imageUrl ordre estActif } versetDuJour { reference texte meditation } citationDuJour { auteur texte } dernierSermon { id titre } prochainEvenements { id titre dateDebut lieu } estEnDirect } }"
}

### 🔑 [SUPER_ADMIN] Mettre à jour la configuration de la page d'accueil
POST {{graphql_url}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation ModifierConfigurationAccueil($programmeHebdomadaire: String, $imagesAccueil: [ImageAccueilInput!]) { modifierConfigurationAccueil(programmeHebdomadaire: $programmeHebdomadaire, imagesAccueil: $imagesAccueil) { programmeHebdomadaire imagesAccueil { id imageUrl ordre estActif } } }",
  "variables": {
    "programmeHebdomadaire": "https://res.cloudinary.com/.../programme.pdf",
    "imagesAccueil": [
      {
        "imageUrl": "https://res.cloudinary.com/.../banner_culte.jpg",
        "cloudinaryPublicId": "accueil/banner_culte",
        "ordre": 0,
        "estActif": true
      },
      {
        "imageUrl": "https://res.cloudinary.com/.../banner_bapteme.jpg",
        "cloudinaryPublicId": "accueil/banner_bapteme",
        "ordre": 1,
        "estActif": true
      }
    ]
  }
}


